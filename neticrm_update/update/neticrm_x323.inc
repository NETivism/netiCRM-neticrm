<?php

function _neticrm_update_update_x323() {
  civicrm_initialize();

  // Check if table exists first
  $query = "SHOW TABLES LIKE 'civicrm_contribution_spgateway'";
  $result = CRM_Core_DAO::executeQuery($query);
  $table_exists = $result->N > 0;

  if (!$table_exists) {
    echo "Table civicrm_contribution_spgateway does not exist. Skipping update.";
    return;
  }

  $query = "SHOW COLUMNS FROM `civicrm_contribution_spgateway` LIKE 'token_value'";
  $result = CRM_Core_DAO::executeQuery($query);
  $column_exists = $result->N > 0;

  if (!$column_exists) {
    $query = <<<EOT
      ALTER TABLE `civicrm_contribution_spgateway`
      ADD COLUMN `contribution_recur_id` int unsigned COMMENT 'Contribuution Recur ID',
      ADD COLUMN `trade_no` varchar(255) COMMENT 'Trade number generated by spgateway',
      ADD COLUMN `token_value` varchar(255) COMMENT 'token_value for credit card agreement payment',
      ADD COLUMN `token_life` date COMMENT 'token life for credit card agreement payment',
      ADD COLUMN `last_four` varchar(32) COMMENT 'The last four number of credit card.',
      ADD COLUMN `expiry_date` date COMMENT 'Used date time of this track.',
      ADD COLUMN `created_id` int unsigned COMMENT 'FK to civicrm_contact, who created this contribution'
    EOT;
    CRM_Core_DAO::executeQuery($query);

    $query = <<<EOT
      ALTER TABLE `civicrm_contribution_spgateway`
      ADD INDEX `index_expiry_date` (`expiry_date`)
    EOT;
    CRM_Core_DAO::executeQuery($query);

    $query = <<<EOT
      ALTER TABLE `civicrm_contribution_spgateway`
      ADD CONSTRAINT `FK_civicrm_contribution_spgateway_contribution_recur_id` FOREIGN KEY (`contribution_recur_id`)
        REFERENCES `civicrm_contribution_recur`(`id`) ON DELETE SET NULL,
      ADD CONSTRAINT `FK_civicrm_contribution_spgateway_created_id` FOREIGN KEY (`created_id`)
        REFERENCES `civicrm_contact`(`id`) ON DELETE SET NULL;
    EOT;
    CRM_Core_DAO::executeQuery($query);

    // loop current contribution to update contribution_recur_id into civicrm_contribution_spgateway
    $query = <<<EOT
      UPDATE civicrm_contribution_spgateway csg
        INNER JOIN civicrm_contribution cc ON csg.cid = cc.id
        SET csg.contribution_recur_id = cc.contribution_recur_id
      WHERE cc.contribution_recur_id IS NOT NULL
    EOT;
    CRM_Core_DAO::executeQuery($query);

    echo "Added civicrm_contribution_spgateway token_value columns.";
  }
  else {
    echo "civicrm_contribution_spgateway token_value column already exists.";
  }
  // remove url_api_default, url_recur_default from spgateway which is no more usable and confuse
  $query = "UPDATE civicrm_payment_processor_type SET url_api_default = NULL, url_recur_default = NULL WHERE name LIKE 'SPGATEWAY%' AND (url_api_default IS NOT NULL OR url_recur_default IS NOT NULL)";
  CRM_Core_DAO::executeQuery($query);

  $query = "UPDATE civicrm_payment_processor SET url_api = NULL WHERE payment_processor_type LIKE 'SPGATEWAY%' AND url_api != 1";
  CRM_Core_DAO::executeQuery($query);

  $query = "UPDATE civicrm_payment_processor SET url_recur = NULL WHERE payment_processor_type LIKE 'SPGATEWAY%' AND url_recur != 1";
  CRM_Core_DAO::executeQuery($query);
  echo "Purge SPGATEWAY civicrm_payment_processor_type default";
}
