<?php

function _neticrm_update_update_x327() {
  civicrm_initialize();

  // Check if civicrm_contribution_spgateway table exists
  $query = "SHOW TABLES LIKE 'civicrm_contribution_spgateway'";
  $result = CRM_Core_DAO::executeQuery($query);
  $table_exists = $result->N > 0;

  if (!$table_exists) {
    $sql = "CREATE TABLE civicrm_contribution_spgateway (
      `id` int unsigned NOT NULL AUTO_INCREMENT,
      `cid` int unsigned COMMENT 'FK to contribution table',
      `data` blob COMMENT 'Spgateway return data',
      `contribution_recur_id` int unsigned COMMENT 'Contribuution Recur ID',
      `trade_no` varchar(255) COMMENT 'Trade number generated by spgateway',
      `token_value` varchar(255) COMMENT 'token_value for credit card agreement payment',
      `token_life` date COMMENT 'token life for credit card agreement payment',
      `last_four` varchar(32) COMMENT 'The last four number of credit card.',
      `expiry_date` date COMMENT 'Used date time of this track.',
      `created_id` int unsigned COMMENT 'FK to civicrm_contact, who created this contribution',
      PRIMARY KEY (id),
      UNIQUE INDEX UI_spgateway_id(cid),
      INDEX index_expiry_date(expiry_date),
      CONSTRAINT FK_civicrm_contribution_spgateway_cid FOREIGN KEY (cid) REFERENCES civicrm_contribution(id) ON DELETE SET NULL,
      CONSTRAINT FK_civicrm_contribution_spgateway_contribution_recur_id FOREIGN KEY (contribution_recur_id) REFERENCES civicrm_contribution_recur(id) ON DELETE SET NULL,
      CONSTRAINT FK_civicrm_contribution_spgateway_created_id FOREIGN KEY (created_id) REFERENCES civicrm_contact(id) ON DELETE SET NULL
    ) ENGINE=InnoDB DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci ROW_FORMAT=DYNAMIC";

    CRM_Core_DAO::executeQuery($sql);

    echo "Table civicrm_contribution_spgateway created successfully.";
  }
  else {
    echo "Table civicrm_contribution_spgateway already exists, skipping creation.";
  }
}
